import serial
import time

# Connect to your active port
ser = serial.Serial('COM5', 9600)
time.sleep(2) # Give Arduino time to reset after connecting

try:
    while True:
        # Prompt the user for an angle in the PyCharm terminal
        angle = input("Enter servo angle (0-180 deg, or 'q' to quit): ")
        
        if angle.lower() == 'q':
            break
            
        # Check if the user typed a valid number
        if angle.isdigit():
            angle_int = int(angle)
            
            if 0 <= angle_int <= 180:
                # Send the angle to the Arduino
                ser.write(str(angle_int).encode())
                print(f"Moving servo to {angle_int} degrees...")
            else:
                print("Angle must be between 0 and 180 degrees.")
        else:
            print("Please enter a valid whole number.")
            
except KeyboardInterrupt:
    pass
finally:
    ser.close()
    print("Serial connection closed.")
